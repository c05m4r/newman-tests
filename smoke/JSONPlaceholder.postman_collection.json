{
  "info": {
    "_postman_id": "14df823c-8c96-4ae0-931e-b6d1238d9ed5",
    "name": "JSONPlaceholder",
    "description": "Colección básica para aprender y practicar peticiones HTTP (GET, POST, PUT, DELETE) utilizando la API de JSONPlaceholder.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "25814545"
  },
  "item": [
    {
      "name": "Obtener todos los posts",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts"
          ]
        },
        "description": "Recupera la lista completa de publicaciones (100 elementos) para verificar la conectividad."
      },
      "response": []
    },
    {
      "name": "Obtener un post por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "1"
          ]
        },
        "description": "Consulta un único post filtrado por su identificador único (ID = 1)."
      },
      "response": []
    },
    {
      "name": "Crear un nuevo post",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Codigo de estado es 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"El post creado tiene un ID asignado\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('id');",
              "});",
              "",
              "pm.test(\"El titulo coincide con el enviado\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.title).to.eql(\"Aprendiendo Postman\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Aprendiendo Postman\",\n  \"body\": \"Este es un nuevo recurso creado para verificar peticiones POST.\",\n  \"userId\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/posts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts"
          ]
        },
        "description": "Envía una nueva publicación a la API REST. Incluye tests de validación automatizada."
      },
      "response": []
    },
    {
      "name": "Actualizar un post existente",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Codigo de estado es 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 1,\n  \"title\": \"Titulo Actualizado via PUT\",\n  \"body\": \"Contenido modificado desde Postman para practicar el metodo PUT.\",\n  \"userId\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/posts/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "1"
          ]
        },
        "description": "Reemplaza completamente un post existente mediante el ID especificado."
      },
      "response": []
    },
    {
      "name": "Eliminar un post",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Respuesta exitosa al eliminar (200 u OK)\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "1"
          ]
        },
        "description": "Envía una solicitud DELETE para simular la eliminación del recurso con ID 1."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://jsonplaceholder.typicode.com"
    }
  ]
}